# Copy to .env (git ignores it) in any project that uses switchboard. Never commit the real .env.

# Which column of jobs.toml to use: local = the mini PC, nonlocal = a frontier API.
AI_ENV=local

# Optional: a TOML file of extra or overriding jobs, merged over switchboard's bundled jobs.toml.
# SWITCHBOARD_CONFIG=./jobs.toml

# Frontier API key, for AI_ENV=nonlocal. The provider isn't chosen yet; LiteLLM reads the
# standard variable for each one, e.g.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
