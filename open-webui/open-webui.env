# Open WebUI settings, passed to its container with `docker run --env-file` by scripts/bootstrap.sh.
# Format: KEY=value, one per line, no quotes (Docker passes the value through as-is). No secrets here:
# Open WebUI generates its own session key inside its data volume.

# The repo is the source of truth. Without this, Open WebUI copies these values into its database
# on first start, and from then on the database wins, so later changes here would be ignored.
# With it, settings edited in the admin screens don't stick; change them here and redeploy.
ENABLE_PERSISTENT_CONFIG=False

# Talk to Ollama in the same container (Open WebUI uses host networking). No OpenAI connection,
# so it doesn't try to reach api.openai.com.
OLLAMA_BASE_URL=http://127.0.0.1:11434
ENABLE_OPENAI_API=False

# Only offer gemma4-cpu in the model picker. gemma4:26b has speculative decoding on (~2.5 tok/s
# here) and tev1 is decision-only (it can't chat).
OLLAMA_API_CONFIGS={"0": {"model_ids": ["gemma4-cpu:latest"]}}
DEFAULT_MODELS=gemma4-cpu:latest

# "legacy" function calling stops Open WebUI attaching its built-in tools (memory, web search,
# code interpreter, ...) to every chat. Those added ~6,300 hidden prompt tokens per message, which
# took ~5 minutes to read on this CPU. think=false: Gemma 4 thinks by default, which means minutes
# of hidden output per reply here.
DEFAULT_MODEL_PARAMS={"function_calling": "legacy", "think": false}

# Background jobs that each send an extra request to the model. Ollama handles one request at a
# time, so these queued up ahead of real messages.
ENABLE_TITLE_GENERATION=False
ENABLE_TAGS_GENERATION=False
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_SEARCH_QUERY_GENERATION=False
ENABLE_RETRIEVAL_QUERY_GENERATION=False
ENABLE_AUTOCOMPLETE_GENERATION=False

# Fewer background calls out to the internet.
ENABLE_VERSION_UPDATE_CHECK=False
